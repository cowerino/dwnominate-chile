#   cd lapack-3.12.1 && mkdir build && cd build && cmake -G "MinGW Makefiles" \
#     -DBUILD_SHARED_LIBS=OFF -DLAPACKE=ON -DCBLAS=OFF -DBUILD_TESTING=OFF \
#     -DCMAKE_BUILD_TYPE=Release .. && cmake --build . -j
